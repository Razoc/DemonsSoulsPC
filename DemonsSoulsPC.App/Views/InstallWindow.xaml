<Window x:Class="DemonsSoulsPC.App.Views.InstallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:DemonsSoulsPC.App.Services"
        Title="{svc:Tr Install.Title}" Height="760" Width="700" MinHeight="600" MinWidth="600"
        WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize"
        Style="{StaticResource MainWindowStyle}"
        Icon="/Resources/dspc.ico">
    <Grid Margin="36">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- En-tête -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,24">
            <Image Source="/Resources/dspc.png" Width="64" Height="64" Margin="0,0,16,0"/>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{svc:Tr App.Name}" Style="{StaticResource TitleTextStyle}"/>
                <TextBlock Text="{svc:Tr App.Tagline}" Style="{StaticResource SubtitleTextStyle}"/>
            </StackPanel>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
        <Border Style="{StaticResource CardStyle}">
            <StackPanel>
                <!-- Choix -->
                <StackPanel x:Name="ChoicePanel">
                    <TextBlock Text="{svc:Tr Install.Welcome}" Style="{StaticResource SectionHeaderStyle}"/>
                    <TextBlock Text="{svc:Tr Install.Intro}" Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap" Margin="0,0,0,20"/>

                    <TextBlock Text="{svc:Tr Install.Language}" Style="{StaticResource MutedTextStyle}" Margin="0,0,0,6"/>
                    <ComboBox x:Name="LanguageBox" Style="{StaticResource ModernComboBoxStyle}" Width="220" HorizontalAlignment="Left"
                              SelectionChanged="LanguageBox_SelectionChanged" Margin="0,0,0,4">
                        <ComboBoxItem Content="Français" Tag="fr"/>
                        <ComboBoxItem Content="English" Tag="en"/>
                    </ComboBox>
                    <TextBlock x:Name="LanguageNote" Style="{StaticResource MutedTextStyle}" Visibility="Collapsed" Margin="0,0,0,4"/>

                    <TextBlock Text="{svc:Tr Install.Folder}" Style="{StaticResource MutedTextStyle}" Margin="0,16,0,6"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="FolderBox" Grid.Column="0" Style="{StaticResource ModernTextBoxStyle}" TextChanged="FolderBox_TextChanged"/>
                        <Button Grid.Column="1" Content="{svc:Tr Common.Browse}" Click="Browse_Click"
                                Style="{StaticResource SecondaryButtonStyle}" Margin="10,0,0,0" MinWidth="110"/>
                    </Grid>
                    <TextBlock x:Name="FolderHint" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    <TextBlock x:Name="FreeSpaceText" Style="{StaticResource MutedTextStyle}" Margin="0,4,0,0"/>

                    <CheckBox x:Name="ShortcutsBox" Content="{svc:Tr Install.Shortcuts}" IsChecked="True"
                              Style="{StaticResource ModernCheckBoxStyle}" Margin="0,16,0,0"/>
                </StackPanel>

                <!-- Progression -->
                <StackPanel x:Name="ProgressPanel" Visibility="Collapsed">
                    <TextBlock Text="{svc:Tr Install.Title}" Style="{StaticResource SectionHeaderStyle}"/>
                    <TextBlock x:Name="StatusText" Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <ProgressBar x:Name="Progress" Maximum="100" Height="10" Style="{StaticResource ModernProgressBarStyle}"/>
                </StackPanel>

                <TextBlock x:Name="ErrorText" Style="{StaticResource ErrorTextStyle}" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,14,0,0"/>
            </StackPanel>
        </Border>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="CancelButton" Content="{svc:Tr Common.Cancel}" Click="Cancel_Click"
                    Style="{StaticResource SecondaryButtonStyle}" MinWidth="110"/>
            <Button x:Name="InstallButton" Content="{svc:Tr Install.Install}" Click="Install_Click"
                    Style="{StaticResource PrimaryButtonStyle}" MinWidth="130" Margin="10,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>
