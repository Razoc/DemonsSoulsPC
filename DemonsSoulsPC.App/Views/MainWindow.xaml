<Window x:Class="DemonsSoulsPC.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:DemonsSoulsPC.App.Services"
        xmlns:local="clr-namespace:DemonsSoulsPC.App.Views"
        Title="Demon’s Souls PC" Width="1280" Height="720"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        Style="{StaticResource MainWindowStyle}"
        Icon="/Resources/dspc.ico">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <local:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="236"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Barre latérale -->
        <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid Margin="18,22,18,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Logo -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="4,0,0,30">
                    <Image Source="/Resources/dspc.png" Width="34" Height="34" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel VerticalAlignment="Center" Margin="12,0,0,0">
                        <TextBlock Text="Demon’s Souls" FontSize="17" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="PC" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" Margin="1,-2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Navigation -->
                <StackPanel Grid.Row="1">
                    <RadioButton Style="{StaticResource RailButtonStyle}" Tag="&#xE80F;" Content="{svc:Tr 'UI.Home'}"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Home}"
                                 Command="{Binding NavigateCommand}" CommandParameter="Home"/>
                    <RadioButton Style="{StaticResource RailButtonStyle}" Tag="&#xE7F4;" Content="{svc:Tr 'UI.Graphics'}"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=GraphicsSettings}"
                                 Command="{Binding NavigateCommand}" CommandParameter="GraphicsSettings"/>
                    <RadioButton Style="{StaticResource RailButtonStyle}" Tag="&#xE7FC;" Content="{svc:Tr 'UI.Controller'}"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=ControllerSettings}"
                                 Command="{Binding NavigateCommand}" CommandParameter="ControllerSettings"/>
                    <RadioButton Style="{StaticResource RailButtonStyle}" Tag="&#xE713;" Content="{svc:Tr 'UI.Advanced'}"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=AdvancedSettings}"
                                 Command="{Binding NavigateCommand}" CommandParameter="AdvancedSettings"/>
                    <RadioButton Style="{StaticResource RailButtonStyle}" Tag="&#xE7B8;" Content="{svc:Tr 'UI.Installation'}"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Installation}"
                                 Command="{Binding NavigateCommand}" CommandParameter="Installation"/>
                </StackPanel>

                <!-- Jouer + état -->
                <StackPanel Grid.Row="2">
                    <TextBlock Text="{Binding StatusMessage}" FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                               TextTrimming="CharacterEllipsis" Margin="4,0,0,8"
                               ToolTip="{Binding StatusMessage}"
                               Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <ProgressBar IsIndeterminate="{Binding IsLoading}" Style="{StaticResource ModernProgressBarStyle}" Height="3" Margin="4,0,4,12"
                                 Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <Button Content="{svc:Tr 'UI.Play'}" Command="{Binding LaunchGameCommand}"
                            Style="{StaticResource PlayButtonStyle}"
                            IsEnabled="{Binding InstallationState.IsInstalled}"/>
                    <TextBlock x:Name="VersionText" FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                               HorizontalAlignment="Center" Margin="0,10,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Contenu -->
        <Grid Grid.Column="1" Background="{StaticResource BackgroundBrush}">
            <ContentControl Content="{Binding CurrentPage, Converter={StaticResource PageTemplateSelector}}"
                            Margin="32,26,32,24" Focusable="False"/>

            <!-- Bandeau de mise à jour -->
            <Border VerticalAlignment="Top" Margin="32,18,32,0" Padding="16,12"
                    Visibility="{Binding ShowUpdateNotification, Converter={StaticResource BooleanToVisibilityConverter}}"
                    Background="{StaticResource SurfaceLightBrush}" CornerRadius="12"
                    BorderBrush="{StaticResource PrimaryBrush}" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="24" ShadowDepth="4" Opacity="0.5"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" FontSize="18" Foreground="{StaticResource PrimaryLightBrush}"
                               VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{svc:Tr 'UI.UpdateAvailable'}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="{Binding UpdateState.LatestUpdate.Version}" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="{svc:Tr 'UI.Later'}" Command="{Binding IgnoreUpdateCommand}" Style="{StaticResource GhostButtonStyle}" Margin="0,0,8,0"
                                Visibility="{Binding UpdateState.IsDownloading, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                        <Button Content="{svc:Tr 'UI.UpdateNow'}" Command="{Binding DownloadUpdateCommand}" Style="{StaticResource PrimaryButtonStyle}"
                                MinHeight="36" Height="36" Padding="16,0" FontSize="13"
                                Visibility="{Binding UpdateState.IsDownloading, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                        <TextBlock Text="{svc:Tr 'UI.Downloading'}" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"
                                   Visibility="{Binding UpdateState.IsDownloading, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
