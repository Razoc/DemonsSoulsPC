{
  "$schema": "https://recomplauncher.com/schema/recomplauncher.json",
  "format": 1,
  "name": "Demon's Souls PC",
  "repo": "Razoc/DemonsSoulsPC",
  "game": {
    "kind": "folder",
    "label": "Your decrypted PS5 dump of Demon's Souls (PPSA01341 or another region): the folder with eboot.bin, sce_module and sce_sys. It is never changed.",
    "check": { "file": "eboot.bin" }
  },
  "prepare": {
    "program": ["DemonsSoulsPC.exe"],
    "args": ["--prepare", "{game}"],
    "label": "Demon's Souls PC runtime (192 MB) and the game converted from your dump",
    "timeout": 1800,
    "version": "0.1.0",
    "done": ["{install}/Build/RunHybrid/DemonsSouls.exe", "{install}/Build/RunHybrid/kyty_gpu.dll"]
  },
  "start": {
    "program": ["DemonsSoulsPC.exe"],
    "args": ["--play"]
  },
  "config": [
    {
      "id": "main",
      "format": "json",
      "file": [{ "path": "{install}/Build/dspc-settings.json" }],
      "game_path": "gameDumpPath"
    }
  ],
  "saves": [
    "{install}/Build/RunHybrid/_sd",
    "{install}/Build/RunHybrid/_sd_mem",
    "{install}/Build/RunHybrid/_trophy",
    "{install}/Build/dspc-settings.json"
  ],
  "folders": {
    "saves": [{ "path": "{install}/Build/RunHybrid/_sd" }],
    "logs": [{ "path": "{install}/Logs" }],
    "game": [{ "path": "{install}/Build/RunHybrid" }]
  },
  "looks": {
    "allowed": false,
    "reason": "The game runs in a second program (Build\\RunHybrid\\DemonsSouls.exe) started by Demon's Souls PC, so ReShade looks don't reach it."
  },
  "settings": [
    {
      "id": "quality", "label": "Rendering quality", "group": "Picture",
      "help": "Performance uses the PS5 Performance mode settings (no 4K rendering). Quality keeps the game's own 4K Fidelity settings and is much heavier.",
      "choices": [
        { "label": "Performance", "set": { "lighting": "0" } },
        { "label": "Quality (4K)", "set": { "lighting": "1" } }
      ],
      "defaults": { "lighting": "0" }
    },
    {
      "id": "fps", "label": "Frame rate limit", "group": "Picture",
      "help": "The game aims for 60 in Performance mode.",
      "choices": [
        { "label": "30", "set": { "fps": "0" } },
        { "label": "35", "set": { "fps": "1" } },
        { "label": "45", "set": { "fps": "2" } },
        { "label": "50", "set": { "fps": "3" } },
        { "label": "55", "set": { "fps": "4" } },
        { "label": "60", "set": { "fps": "5" } },
        { "label": "No limit", "set": { "fps": "6" } }
      ],
      "defaults": { "fps": "5" }
    },
    {
      "id": "vsync", "label": "V-Sync", "group": "Picture",
      "help": "Removes tearing.",
      "choices": [
        { "label": "Off", "set": { "vsync": "false" } },
        { "label": "On", "set": { "vsync": "true" } }
      ],
      "defaults": { "vsync": "false" }
    },
    {
      "id": "window", "label": "Window", "group": "Display",
      "help": "Fullscreen or windowed. In Big Picture mode the game always opens fullscreen.",
      "choices": [
        { "label": "Fullscreen", "set": { "fullscreen": "true" } },
        { "label": "Windowed", "set": { "fullscreen": "false" } }
      ],
      "defaults": { "fullscreen": "true" }
    },
    {
      "id": "size", "label": "Resolution", "group": "Display",
      "help": "The size of the game's picture.",
      "choices": [
        { "label": "1280 x 720", "set": { "size": "0" } },
        { "label": "1600 x 900", "set": { "size": "1" } },
        { "label": "1920 x 1080", "set": { "size": "2" } },
        { "label": "2560 x 1440", "set": { "size": "3" } }
      ],
      "defaults": { "size": "2" }
    },
    {
      "id": "overlay", "label": "FPS counter", "group": "Display",
      "help": "The frame rate in the top right corner of the game.",
      "choices": [
        { "label": "Off", "set": { "overlay": "0" } },
        { "label": "On", "set": { "overlay": "1" } }
      ],
      "defaults": { "overlay": "0" }
    }
  ],
  "actions": [
    { "id": "logs", "label": "Logs", "help": "Demon's Souls PC's and the game's logs, to attach to a bug report.", "open": "logs" },
    { "id": "saves", "label": "Saves", "help": "Your Demon's Souls progress.", "open": "saves" },
    { "id": "cache", "label": "Shader cache", "help": "Shaders already built, for less stutter. Only clear it if the picture looks wrong after an update.", "clear": "game/_PipelineCache" }
  ]
}
